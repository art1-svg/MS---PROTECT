        // Function to update the content based on the selected language
        function changeLanguage() {
            const lang = document.getElementById('language-select').value;
            const currentTranslations = translations[lang];

            // Keys that contain inner HTML (like spans for placeholders or bolded amounts)
            const htmlContentKeys = [
                'retainerIntro',
                'creditReportAuthIntro',
                'socialMediaWaiverIntro',
                'retainerFeeAmount',
                'hourlyRate',
                'paralegalRate',
                'interestRate'
            ];

            // Update elements with data-lang-key attribute
            document.querySelectorAll('[data-lang-key]').forEach(element => {
                const key = element.getAttribute('data-lang-key');
                if (currentTranslations[key]) {
                    // Use innerHTML for content that contains nested HTML (like spans)
                    if (htmlContentKeys.includes(key)) {
                        element.innerHTML = currentTranslations[key];
                    } else {
                        // Use textContent for plain text elements
                        element.textContent = currentTranslations[key];
                    }
                }
            });

            // Update placeholders for client name and current date after the content is set
            updatePlaceholders();
        }

        // Function to update client name and current date placeholders
        function updatePlaceholders() {
            const fullNameInput = document.getElementById('fullName');
            // Ensure elements exist before trying to update them
            const clientNamePlaceholder = document.getElementById('clientNamePlaceholder');
            const authClientNamePlaceholder = document.getElementById('authClientNamePlaceholder');
            const socialClientNamePlaceholder = document.getElementById('socialClientNamePlaceholder');
            const currentDatePlaceholder = document.getElementById('currentDatePlaceholder');

            const clientName = fullNameInput ? fullNameInput.value : "[Client Full Name]";
            const currentDate = new Date().toLocaleDateString(document.getElementById('language-select').value);

            if (clientNamePlaceholder) clientNamePlaceholder.textContent = clientName;
            if (authClientNamePlaceholder) authClientNamePlaceholder.textContent = clientName;
            if (socialClientNamePlaceholder) socialClientNamePlaceholder.textContent = clientName;
            if (currentDatePlaceholder) currentDatePlaceholder.textContent = currentDate;
        }

        // Event listener for full name input to update placeholders dynamically
        document.getElementById('fullName').addEventListener('input', updatePlaceholders);

        // Set initial language and update placeholders on page load
        window.onload = function() {
            changeLanguage(); // Set initial language and content
            // updatePlaceholders is already called inside changeLanguage, so no need to call it again here.
        };

        // Handle form submission (for demonstration, just logs to console)
        document.getElementById('intakeForm').addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent default form submission

            const formData = new FormData(event.target);
            const formObject = {};
            formData.forEach((value, key) => {
                formObject[key] = value;
            });

            console.log("Form Submitted:", formObject);
